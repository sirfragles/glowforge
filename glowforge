#!/bin/bash
# Launcher glowforge. Szuka srodowiska z fontTools i Pillow.
#
# Dziala w dwoch miejscach:
#   - w repozytorium  — srodowisko to .venv obok skryptu,
#   - w pakiecie .app — Zasoby sa tylko do czytania, wiec i srodowisko,
#     i pliki wyjsciowe mieszkaja w ~/Library/Application Support/GlowForge.
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Czy wolno pisac obok skryptu? W pakiecie .app nie wolno: Zasoby sa czescia
# podpisanej aplikacji i dopisanie tam czegokolwiek uniewaznia podpis.
case "$HERE" in
    *.app/Contents/Resources/*) BAZA="$HOME/Library/Application Support/GlowForge" ;;
    *)                          BAZA="$HERE" ;;
esac
mkdir -p "$BAZA"

if [ -z "$GLOWFORGE_OUT" ] && [ "$BAZA" != "$HERE" ]; then
    export GLOWFORGE_OUT="$BAZA/out"
fi

for PY in "$BAZA/.venv/bin/python3" "$HOME/web_hdr/.venv/bin/python3"; do
    if [ -x "$PY" ]; then exec "$PY" "$HERE/glowforge.py" "$@"; fi
done
if python3 -c "import fontTools, PIL" 2>/dev/null; then
    exec python3 "$HERE/glowforge.py" "$@"
fi
echo "brak srodowiska z fontTools i Pillow" >&2
echo "utworz je:" >&2
echo "  python3 -m venv \"$BAZA/.venv\"" >&2
echo "  \"$BAZA/.venv/bin/pip\" install fonttools Pillow" >&2
exit 1
